# Copy to .env.local for local overrides.

# Base URL the app calls. Leave as /api to use the Vite dev proxy (below),
# or point it at a deployed backend, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Where the dev server proxies /api requests. Dev only.
VITE_PROXY_TARGET=http://localhost:8000
